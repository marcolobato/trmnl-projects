{% comment %}
  Get Outside · Flatirons — paste into TRMNL's markup editor.
  Variables: plate_url  time_of_day  weather  message  date_long
  Reasoning behind each rule below is in flatirons/DECISIONS.md.
{% endcomment %}

<div class="screen">
  <div class="view view--full">

    <div class="layout">
      <div class="scene">
        <img class="image scene__plate"
             src="{{ plate_url }}"
             alt="The Boulder Flatirons, {{ time_of_day }}, {{ weather }}" />
      </div>
    </div>

    <div class="title_bar">
      <span class="title">{{ message }}</span>
      <span class="instance">{{ date_long }}</span>
    </div>

  </div>
</div>

<style>
  .layout { padding: 0; }

  .scene {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  /* No image-dither class — the plate is pre-dithered and would moire. */
  .scene__plate {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    image-rendering: pixelated;
  }

  /* .instance defaults to a secondary grey that vanishes on e-ink. */
  .title_bar .title,
  .title_bar .instance {
    color: #000 !important;
  }

  /* Art sits 10px from the edge (.screen, device default); text 10 + 16. */
  .title_bar {
    padding-left: 16px !important;
    padding-right: 16px !important;
  }
</style>
