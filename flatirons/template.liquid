{% comment %}
  Get Outside · Flatirons — paste into TRMNL's markup editor.
  Values come from the plugin's polling URL:
    plate_url  time_of_day  weather  message  date_long
{% endcomment %}

<div class="screen">
  <div class="view view--full">

    <div class="layout">
      <div class="scene">
        <img class="image scene__plate"
             src="{{ plate_url }}"
             alt="The Boulder Flatirons, {{ time_of_day }}, {{ weather }}" />
      </div>
    </div>

    <div class="title_bar">
      <span class="title">{{ message }}</span>
      <span class="instance">{{ date_long }}</span>
    </div>

  </div>
</div>

<style>
  /* TRMNL makes .layout a flex row, and has a global rule giving every child
     "flex: 1 1 0%". That was sizing the picture narrower than its space and
     leaving blank paper on one side. Block layout takes flex out of it. */
  .layout {
    display: block;
    padding: 0;
    margin: 0;
  }

  .scene {
    display: block;
    position: relative;
    width: 100%;
    height: 100%;
    margin: 0;
    overflow: hidden;
  }

  /* "contain" shows the whole picture. "cover" would fill the space but cut
     off the edges, which is what was trimming the photo.

     No "image-dither" class on the image: it already has the dot pattern
     baked in, and letting TRMNL add its own on top makes a muddy mess. */
  .scene__plate {
    display: block;
    width: 100%;
    height: 100%;
    margin: 0;
    object-fit: contain;
    object-position: center;
    image-rendering: pixelated;
  }

  /* TRMNL makes the date grey by default. Grey almost disappears on an e-ink
     screen, so both labels are forced to solid black. */
  .title_bar .title,
  .title_bar .instance {
    color: #000 !important;
  }

  /* TRMNL already leaves 10px around everything. This adds 16px more inside
     the bar so the text isn't jammed against the rounded corner. */
  .title_bar {
    padding-left: 16px !important;
    padding-right: 16px !important;
  }
</style>
